---
// Secret GIF gallery. Standalone page (like /rdd, /gifz) so the grid owns the whole viewport.
// Files live in /public/superdupersecretgifs and are listed at build time.
// No navigation links point here - only accessible by direct URL.
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';

const dir = join(process.cwd(), 'public', 'superdupersecretgifs');

const files = existsSync(dir)
  ? readdirSync(dir)
      .filter((name) => name.endsWith('.gif'))
      .sort()
  : [];

const title = 'secret gifs -SirHurt';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A pile of secret GIFs." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="hdr">
      <a href="/" class="home-link">← back</a>
      <h1>secret gifs</h1>
    </header>

    {
      files.length === 0 ? (
        <p class="empty">No GIFs found in /public/superdupersecretgifs</p>
      ) : (
        <ul class="grid">
          {files.map((file) => (
            <li>
              <img src={`/superdupersecretgifs/${file}`} alt={file} loading="lazy" />
              <span class="name">{file}</span>
            </li>
          ))}
        </ul>
      )
    }

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #0d0d0d;
        color: #e0e0e0;
        min-height: 100vh;
      }

      .hdr {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #2a2a2a;
        background: #111;
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .home-link {
        color: #888;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s;
      }

      .home-link:hover {
        color: #fff;
      }

      h1 {
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
        padding: 1.5rem;
        list-style: none;
      }

      .grid li {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        background: #161616;
        border: 1px solid #2a2a2a;
        border-radius: 8px;
        padding: 0.75rem;
        transition: border-color 0.2s, transform 0.1s;
      }

      .grid li:hover {
        border-color: #444;
        transform: scale(1.01);
      }

      .grid img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
        image-rendering: pixelated;
      }

      .name {
        font-size: 0.7rem;
        color: #666;
        text-align: center;
        word-break: break-all;
        max-width: 100%;
        font-family: monospace;
      }

      .empty {
        text-align: center;
        padding: 3rem;
        color: #666;
      }

      @media (max-width: 480px) {
        .grid {
          grid-template-columns: 1fr;
          padding: 1rem;
        }
      }
    </style>
  </body>
</html>