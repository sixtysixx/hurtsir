---
// Secret GIF gallery. Standalone page (like /rdd, /gifz) so the grid owns the whole viewport.
// Files live in /public/superdupersecretgifs and are listed at build time.
// Unlinked from navigation, noindex, and filtered out of the sitemap.
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import GifGallery from '../components/GifGallery.astro';

const dir = join(process.cwd(), 'public', 'superdupersecretgifs');

// scripts/optimize_gifs.mjs (run as `prebuild`) converts every GIF in this
// folder to an animated WebP and deletes the source, so the grid is not a
// 187 MB download. Old /superdupersecretgifs/<name>.gif links are 301'd to the
// WebP by the generated public/_redirects.
// Alphabetical: most names are UUIDs or `balls-*`, so a leading-number sort
// would collapse the order the way it works for /gifz.
const files = existsSync(dir)
  ? readdirSync(dir)
      .filter((name) => name.endsWith('.webp'))
      .sort()
  : [];

const title = 'secret gifs -SirHurt';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A pile of secret GIFs." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="hdr">
      <p><a class="brand" href="/"><strong>SirHurt</strong></a> &mdash; secret gifs</p>
      <p class="notice">{files.length} gif{files.length === 1 ? '' : 's'}</p>
    </header>

    <GifGallery
      files={files}
      basePath="/superdupersecretgifs"
      label="Secret GIF"
      emptyMessage="No images found in public/superdupersecretgifs. Drop GIFs in there and run npm run build (the prebuild step converts them to WebP)."
    />

    <style>
      :root {
        color-scheme: dark;
        --bg: #0a0a14;
        --surface: #14141f;
        --hairline: rgba(157, 78, 221, 0.2);
        --accent: #9d4edd;
        --text: #c0c0c0;
        --white: #ececf4;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 1.5rem clamp(1rem, 4vw, 3rem) 3rem;
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background:
          radial-gradient(ellipse 80% 60% at 50% -10%, rgba(42, 26, 74, 0.9) 0%, transparent 60%),
          radial-gradient(circle at 15% 40%, rgba(157, 78, 221, 0.12) 0%, transparent 45%),
          var(--bg);
        min-height: 100vh;
      }

      a {
        color: var(--accent);
      }

      .hdr {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        align-items: baseline;
        justify-content: space-between;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--hairline);
      }

      .hdr p {
        margin: 0;
      }

      .brand {
        color: var(--white);
        text-decoration: none;
        font-weight: 600;
      }

      .notice {
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
