# Required: your Discord account token (selfbot - this drives your own user account).
DISCORD_TOKEN=

# Optional: comma-separated channel ids to answer in. Empty/unset = every channel the
# account can read.
# FAQ_ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432

# Optional: 1/true = match and log only, send nothing.
# FAQ_DRY_RUN=1

# Optional: per-user cooldown in seconds (default 15).
# FAQ_COOLDOWN_S=15

# Optional: comma-separated role ids treated as staff/CSR. Whoever asked the question, or any
# member with one of these roles, can retract a bad answer by reacting to it with the red X.
# Empty/unset = only the original asker can retract.
# FAQ_CSR_ROLE_IDS=123456789012345678
